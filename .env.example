# --- Neon (Postgres + Auth) -------------------------------------------------
# `neon deploy` preenche estas variáveis em .env.local automaticamente.
# Use a connection string POOLED (host com "-pooler") na Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.sa-east-1.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth"
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# --- Nuvemshop ---------------------------------------------------------------
NUVEMSHOP_APP_ID=""              # ID do app no Portal de Parceiros (URL de autorização)
NUVEMSHOP_CLIENT_ID=""
NUVEMSHOP_CLIENT_SECRET=""
NUVEMSHOP_APP_NAME="INuvem"
NUVEMSHOP_CONTACT_EMAIL="wagnergarnizet@hotmail.com"
# NUVEMSHOP_API_VERSION="v1"     # opcional (padrão v1)

# --- Segurança ---------------------------------------------------------------
# openssl rand -base64 32  (exatamente 32 bytes em base64)
ENCRYPTION_KEY=""
# openssl rand -hex 32  (a Vercel envia como "Authorization: Bearer ..." no cron)
CRON_SECRET=""
# E-mails (separados por vírgula) liberados no painel; usados por `npm run db:seed-admin`
ADMIN_EMAILS="voce@exemplo.com"

# --- E-mail do resumo diário (opcional) ---------------------------------------
# Chave do Resend (https://resend.com). Sem ela, o resumo diário por e-mail fica indisponível.
RESEND_API_KEY=""
# Remetente. Padrão "INuvem <onboarding@resend.dev>", que só entrega para o e-mail dono da conta Resend; para outros destinatários, verifique um domínio no Resend.
# RESEND_FROM="INuvem <resumo@seudominio.com.br>"

# --- Arquivo de menu por FTP (opcional) ----------------------------------------
# Envia snipplets/navigation/hidden-menu-urls.tpl com as categorias ocultas (Automações). Sem estas variáveis o envio fica indisponível.
# FTP_HOST="ftp.seudominio.com.br"
# FTP_USER=""
# FTP_PASSWORD=""
# Pasta do tema onde está o navigation-top.tpl (o painel confere que o arquivo existe antes de gravar)
# FTP_MENU_DIR="/public_html/temas/seu-tema/snipplets/navigation"
# FTP_SECURE="explicit"  # "explicit" (FTPS na porta 21, padrão) ou "implicit" (porta 990)
# FTP_PORT="21"
# FTP_VERIFICAR_CERTIFICADO="nao"  # só se o certificado do servidor não confere e você confia nele

# --- Aplicação ---------------------------------------------------------------
APP_URL="http://localhost:3000"  # em produção: https://seu-app.vercel.app
